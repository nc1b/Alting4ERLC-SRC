def load_config(info):
    global error  # inserted
    config_path = os.path.join(application_path, 'configs.json')
    if not os.path.exists(config_path):
        with open(config_path, 'w', encoding='utf-8') as f:
            default_config = {'serverPort': 8123, 'useLander': True, 'listenPort': 4000, 'waitType': 0, 'waitTime': 5, 'memoryThreshold': 95, 'ramPort': 'unspecified', 'ramPassword': 'unspecified', 'autoMinimize': False}
            json.dump(default_config, f, indent=4)
            f.close()
    with open(config_path, 'r', encoding='utf-8') as f:
        try:
            data = json.load(f)
            return data.get(info)
    except Exception as e:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' {e}')
        error = True
        autoClose()

def save_config(name, data):
    config_path = os.path.join(application_path, 'configs.json')
    if os.path.exists(config_path):
        with open(config_path, 'r', encoding='utf-8') as f:
            try:
                existing_data = json.load(f)
    if name == 'ramPort' or name == 'ramPassword':
        existing_data[name] = str(data)
    with open(config_path, 'w', encoding='utf-8') as f:
        json.dump(existing_data, f, indent=4)
    except json.JSONDecodeError:
        existing_data = {}

def clickOnScreen(x, y):

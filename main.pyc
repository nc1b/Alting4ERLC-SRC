    print(option_line('4', Fore.GREEN, ' Fix Auto-Launch'))
    print(option_line('5', Fore.WHITE, ' Return to Main Menu'))
    print(bottom)
    choice = input(Style.BRIGHT + Fore.CYAN + 'Select an option (1-5): ' + Style.RESET_ALL)
    if choice == '1':
        listRamConfiguration()
    roblox_uri = 'roblox-player://'
    url = f'http://localhost:{serverPort}/launch?roblox_uri={roblox_uri}'
    launcher = Flask(__name__)
    import logging
    from flask import redirect
    log = logging.getLogger('werkzeug')
    log.setLevel(logging.ERROR)

    @launcher.route('/launch')
    def launchRoblox():
        uri = request.args.get('roblox_uri')
        return redirect(uri)

    def runRobloxServer():
        launcher.run(host='127.0.0.1', port=serverPort)
    print('[*] Starting server...')
    try:
        threading.Thread(target=runRobloxServer, daemon=True).start()
        driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)
        driver.get(url)
        print()
        t.sleep(1)
        input('Press enter once you\'re done and Roblox has launched (you can close the Roblox app).')
        driver.quit()
        menu()
    except OSError as e:
        print(f'Failed to start Flask server: {e}')

def load_fflags():
    fflags_path = os.path.join(application_path, 'fflags.json')
    if not os.path.exists(fflags_path):
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' fflags.json not found at {fflags_path}, creating a new one with default values.')
        with open(fflags_path, 'w', encoding='utf-8') as f:
            f.write('{\"FLogNetwork\":\"7\",\"FFlagHandleAltEnterFullscreenManually\":\"False\",\"DFIntTaskSchedulerTargetFps\":\"5\",\"FIntRenderShadowIntensity\":\"0\",\"FFlagDisablePostFx\":\"True\",\"FIntTerrainArraySliceSize\":\"0\",\"FIntDebugForceMSAASamples\":\"1\",\"DFFlagTextureQualityOverrideEnabled\":\"True\",\"DFIntTextureQualityOverride\":\"0\",\"FIntFRMMinGrassDistance\":0,\"FIntFRMMaxGrassDistance\":0,\"FIntRenderGrassDetailStrands\":0,\"FIntRenderGrassHeightScaler\":0,\"DFIntCSGLevelOfDetailSwitchingDistance\":0,\"DFIntCSGLevelOfDetailSwitchingDistanceL12\":0,\"DFIntCSGLevelOfDetailSwitchingDistanceL23\":0,\"DFIntCSGLevelOfDetailSwitchingDistanceL34\":0,\"FIntRenderLocalLightUpdatesMax\":1,\"FIntRenderLocalLightUpdatesMin\":1,\"FFlagDebugSkyGray\":true,\"DFIntDebugFRMQualityLevelOverride\":1}')
            print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' Created fflags.json with default values at {fflags_path}')
            load_fflags()
    with open(fflags_path, 'r', encoding='utf-8') as f:
        return f.read()

def get_newest_version_folder(base_path):
    try:
        version_folders = [f for f in os.listdir(base_path) if f.startswith('version-') and os.path.isdir(os.path.join(base_path, f))]
            if not version_folders:
                pass  # postinserted
            return None
    except Exception:
        return None

def is_exe_running(exe_name):
    for proc in psutil.process_iter(['name']):
        try:
            if proc.info['name'] and proc.info['name'].lower() == exe_name.lower():
                break
                return True
    else:  # inserted
        return False
    except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
        pass

def open_and_close_browser(roblox_uri):
    pause_event.wait()
    serverPort = load_config('serverPort')
    import urllib
    os.environ['WDM_LOG_LEVEL'] = '0'
    encoded_uri = urllib.parse.quote(roblox_uri)
    url = f'http://localhost:{serverPort}/launch?roblox_uri={encoded_uri}'
    driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)
    driver.get(url)
    t.sleep(1)
    driver.quit()

def overwriteFFlags():
    global fullFFlagsPath  # inserted
    FFlags = load_fflags()
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + ' Using the following defined FFlags: ' + FFlags)
    local_appdata = os.environ.get('LOCALAPPDATA')
    found = False
    for program in ['Bloxstrap', 'Roblox']:
        base_path = os.path.join(local_appdata, program, 'Versions')
        newest_version_folder = get_newest_version_folder(base_path)
        if not newest_version_folder:
            continue
        client_settings_path = os.path.join(newest_version_folder, 'ClientSettings')
        os.makedirs(client_settings_path, exist_ok=True)
        fullFFlagsPath = os.path.join(client_settings_path, 'ClientAppSettings.json')
        try:
            with open(fullFFlagsPath, 'w') as f:
                try:
                    fflags_json = json.loads(FFlags)
                    json.dump(fflags_json, f, indent=4)
                    f.close()
                    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.LIGHTBLUE_EX + Style.BRIGHT + '[FOUND]' + Style.RESET_ALL + f' Version folder found for \'{program}\': {newest_version_folder}' + Style.RESET_ALL)
                    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' File overwritten: {fullFFlagsPath}' + Style.RESET_ALL)
                    found = True
                    break
    if not found:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + ' Could not find a valid version folder in either Bloxstrap or Roblox.')
        if fullFFlagsPath:
            print(f'Tried path: {fullFFlagsPath}')
        return None
    except json.JSONDecodeError, f.write(FFlags):
        pass  # postinserted
    except Exception as e:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' Failed to write to {fullFFlagsPath}: {e}')

def resetFFlags():
    global error  # inserted
    try:
        os.remove(fullFFlagsPath)
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' File \'{fullFFlagsPath}\' deleted successfully.')
        error = True
    except Exception as e:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' {e}')
        error = True
        autoClose()

def deployBots(serverCode, playersNum):

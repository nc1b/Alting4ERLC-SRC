    @serverCode.route('/')
    def index():
        return render_template_string('\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <title>AutoERLC Terminal</title>\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"https://i.ibb.co/7wtBbSJ/image.png\">\n  <style>\n    @import url(\'https://fonts.googleapis.com/css2?family=Heebo:wght@200&display=swap\');\n    body {\n      background: rgb(1, 0, 78);\n      color: white;\n      font-family: \'Heebo\', sans-serif;\n      text-align: center;\n      padding: 20px;\n    }\n    .navbar {\n      overflow: hidden;\n      background-color: #111;\n      padding: 5px;\n    }\n    .navbar p {\n      float: left;\n      margin: 0;\n      padding: 0 10px;\n      line-height: 32px;\n    }\n    .navbar-buttons {\n      float: right;\n      line-height: 32px;\n    }\n    .navbar-buttons a {\n      margin-left: 10px;\n      color: white;\n    }\n    .logo_button {\n      float: left;\n    }\n    .boldhr {\n      height: 3px;\n      background: white;\n      border: none;\n      margin: 20px 0;\n    }\n    .input-group {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      margin: 10px 0;\n    }\n    .num {\n      font-size: 16px;\n      color: white;\n      background-color: black;\n      padding: 5px;\n      border: 1px solid #aec8ff;\n      display: inline-block;\n      justify-content: right;\n      width: 40px;\n      border-radius: 10px;\n    }\n    .code {\n      background-color: #000000;\n      color: white;\n      border-radius: 5px;\n      border: 1px solid #aec8ff;\n    }\n  </style>\n</head>\n    <body>\n        <div class=\"navbar\">\n          <a href=\"https://discord.gg/u6SHu82yqh\" target=\"_blank\">\n            <img class=\"logo_button\" src=\"https://i.ibb.co/7wtBbSJ/image.png\" height=\"32\" width=\"32\" alt=\"Logo\">\n          </a>\n          <p>Developed by @cycl00ne_ on Discord</p>\n          <div class=\"navbar-buttons\">\n            <a href=\"https://discord.gg/u6SHu82yqh\" target=\"_blank\">Support</a>\n          </div>\n        </div>\n        <h1>AutoERLC Landing Page</h1>\n        <hr class=\"boldhr\">\n        <h3>Bot Info</h3>\n        <div class=\"input-group\">\n            <p>Server Code:<div class=\"code\"> {{ serverCode }}</div></p>\n        </div>\n        <div class=\"input-group\">\n            <p>Number of Players: <div class=\"num\">{{ playersNum }}</div></p>\n        </div>\n        <h3>The script is doing its magic. No intervention should be needed. Sit back and watch the show.</h3>\n      </body>\n</html>\n        ', serverCode=serverCode, playersNum=playersNum)

    @serverCode.route('/launch')
    def launchRoblox():
        uri = request.args.get('roblox_uri')
        return redirect(uri)

    def runRobloxServer():
        launcher.run(host='127.0.0.1', port=serverPort)
    if __name__ == '__main__':
        print('[*] Starting server...')
        try:
            threading.Thread(target=runRobloxServer, daemon=True).start()
            t.sleep(1.5)
    if False:
        pass  # postinserted
    for i in range(playersNum):
        pause_event.wait()
        display_name = f'DemoAccount{i + 1}' if demo_mode else usernames[i]
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Attempting to launch account {i + 1}/{playersNum}: {display_name}')
        ROBLOSECURITY_COOKIE = requests.get(f'http://localhost:{ramPort}/GetCookie?Account={usernames[i]}&Password={ramPassword}').text.strip()
        session = requests.Session()
        session.headers.update({'User-Agent': 'Mozilla/5.0', 'Referer': 'https://www.roblox.com/home', 'Origin': 'https://www.roblox.com', 'Cookie': f'.ROBLOSECURITY={ROBLOSECURITY_COOKIE}'})
        csrf_res = session.post('https://auth.roblox.com/v2/logout')
        csrf_token = csrf_res.headers.get('x-csrf-token')
        if not csrf_token:
            print('[-] Failed to get X-CSRF-TOKEN, launching an extra account.')
            i += 1
        session.headers['X-CSRF-TOKEN'] = csrf_token
        session.headers['Content-Type'] = 'application/json'
        print('[*] Requesting Auth Ticket...')
        auth_res = session.post('https://auth.roblox.com/v1/authentication-ticket')
        auth_ticket = auth_res.headers.get('rbx-authentication-ticket')
        if not auth_ticket:
            print('[-] Auth ticket was not returned, launching an extra account.')
            print('[Debug] Status Code:', auth_res.status_code)
            print('[Debug] Headers:', auth_res.headers)
            print('[Debug] Body:', auth_res.text)
            i += 1

        def generate_roblox_player_uri(auth_ticket, place_id, launch_data):
            timestamp = int(t.time() * 1000)
            browser_tracker_id = timestamp + 1
            join_attempt_id = str(uuid.uuid4())
            launch_data_json = launch_data if isinstance(launch_data, str) else str(launch_data).replace('\'', '\"')
            encoded_launch_data = urllib.parse.quote(launch_data_json)
            launcher_url = f'https://www.roblox.com/Game/PlaceLauncher.ashx?request=RequestGame&browserTrackerId={browser_tracker_id}&placeId={place_id}&launchData={encoded_launch_data}&isPlayTogetherGame=false&referredByPlayerId=0&joinAttemptId={join_attempt_id}&joinAttemptOrigin=PlayButton'
            encoded_launcher_url = urllib.parse.quote(launcher_url)
            uri = f'roblox-player:1+launchmode:play+gameinfo:{auth_ticket}+launchtime:{timestamp}+placelauncherurl:{encoded_launcher_url}+browsertrackerid:{browser_tracker_id}+robloxLocale:en_us+gameLocale:en_us+channel:'
            return uri
        roblox_uri = generate_roblox_player_uri(auth_ticket, place_id=2534724415, launch_data={'psCode': serverCode})
        print('[*] Opening Roblox...')
        print(roblox_uri)
        open_and_close_browser(roblox_uri)
        if autoMinimize:
            t.sleep(1)
            print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Auto-minimizing Roblox window for account {i + 1}/{playersNum}...')
            autoit.win.win_set_state('Roblox', properties.SW_MINIMIZE)
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' Successfully launched account {i + 1}/{playersNum}: {display_name}')
        if waitType == 0:
            print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Waiting for {waitTime} seconds before launching next account...')
            t.sleep(waitTime)
        else:  # inserted
            if waitType == 1:
                print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Waiting for memory usage to drop below {memoryThreshold}% before launching next account...')
                pass
                mem_usage = psutil.virtual_memory().percent
                if mem_usage < memoryThreshold:
                    pass  # postinserted
                print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' Memory usage is now {mem_usage}%, proceeding to launch next account.')
            else:  # inserted
                print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' Memory usage is {mem_usage}%, trying again...')
                t.sleep(3)
            else:  # inserted
                if waitType == 2:
                    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Waiting for {waitTime} seconds and memory usage to drop below {memoryThreshold}% before launching next account...')
                    t.sleep(waitTime)
                    pass
                    mem_usage = psutil.virtual_memory().percent
                    if mem_usage < memoryThreshold:
                        pass  # postinserted
                    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + f' Memory usage is now {mem_usage}%, proceeding to launch next account.')
                else:  # inserted
                    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' Memory usage is {mem_usage}%, trying again...')
                    t.sleep(3)
                else:  # inserted
                    print(waitType)
                    autoClose()
    print()
    if useLander:
        pass  # postinserted
    if False:
        pass  # postinserted
    resetFFlags()
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + ' All bots should be in. You will need to manually idle-check if needed.')
    t.sleep(5)
    menu()
        except OSError as e:
            print(f'Failed to start Flask server: {e}')


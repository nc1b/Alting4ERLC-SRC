def networkListen():
    sys.stdout = QueueOutput()
    start_web_terminal()
    for i in range(4):
        start()
        i += 1

def checkHash():
    with open(os.path.join(application_path, file_name), 'rb') as f:
        file_hash = hashlib.sha256(f.read()).hexdigest()
    try:
        response = r.get('https://cyclonesstuff-default-rtdb.firebaseio.com/hash/' + version.replace('.', '') + '.json')
        expected_hash = response.json()
        expected_hash = str(expected_hash).strip('\"')
        if expected_hash == 'None':
            r.patch('https://cyclonesstuff-default-rtdb.firebaseio.com/hash.json', json={version.replace('.', ''): file_hash})
            sys.exit()
        sys.exit() if not isinstance(expected_hash, str) else expected_hash
        if file_hash!= expected_hash:
            sys.exit()
        return None
    except Exception as e:
        sys.exit()

def checkVersion():
    req = 'https://cyclonesstuff-default-rtdb.firebaseio.com/version.json'
    try:
        res = r.get(req)
    res = res.json()
    return res
    except Exception:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + ' Failed to retrieve new version.')

def option_line(num, color, text, box_width=40):
    prefix = Style.BRIGHT + Fore.BLACK + f'{num}:' + Style.RESET_ALL
    colored_text = Style.BRIGHT + color + text + Style.RESET_ALL
    visible_len = 3 + len(text)
    pad = box_width - 2 - visible_len
    return '│ ' + prefix + colored_text + ' ' * pad + '│'

def menu():
    res = checkVersion()
    if res!= version:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + ' A new version of the script is available! Contact Cyclone for update assistance.')
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + Style.BRIGHT + Fore.LIGHTRED_EX + f' {version}' + Fore.WHITE + ' -> ' + Fore.GREEN + f'{res}')
    box_width = 40
    print(Style.RESET_ALL, end='')
    top = '┌' + '─' * (box_width - 2) + '┐'
    title = '│' + Style.BRIGHT + Back.WHITE + Fore.BLACK + ' OPTIONS '.center(box_width - 2) + Style.RESET_ALL + '│'
    sep = '├' + '─' * (box_width - 2) + '┤'
    bottom = '└' + '─' * (box_width - 2) + '┘'
    opt1_text = ' Run Bot Script'
    opt2_text = ' Overwrite FFlags'
    opt3_text = ' Reset FFlags'
    opt4_text = ' Setup Configuration'
    opt5_text = ' Listening Mode'
    print(top)
    print(title)
    print(sep)
    print(option_line('1', Fore.YELLOW, opt1_text))
    print(option_line('2', Fore.MAGENTA, opt2_text))
    print(option_line('3', Fore.GREEN, opt3_text))
    print(option_line('4', Fore.BLUE, opt4_text))
    print(option_line('5', Fore.RED, opt5_text))
    print(bottom)
    choice = input(Style.BRIGHT + Fore.CYAN + 'Select an option (1-5): ' + Style.RESET_ALL)
    if choice == '1':
        startUp()
    return None

def checkKeyUser():
    with open(os.path.join(application_path, 'LICENSE.key'), 'r') as f:
        key = f.readline()
        key = key.strip()
        try:
            res = r.get(f'https://cyclonesstuff-default-rtdb.firebaseio.com/license_keys/{key}/username.json')
        if res.status_code!= 200:
            failActivation()
        data = res.json()
        f.close()
        return data
    except Exception:
        failActivation()

def get_powershell_value(wmi_class, property_name):
    try:
        cmd = ['powershell', '-Command', f'Get-WmiObject Win32_{wmi_class.capitalize()} | Select-Object -ExpandProperty {property_name}']
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        value = result.stdout.strip()
        return value if value else False
        failActivation()
    except Exception as e:
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + f' Error retrieving HWID info: {e}')
        autoClose()

def get_machine_hwid():
    bios_serial = get_powershell_value('bios', 'SerialNumber')
    baseboard_serial = get_powershell_value('baseboard', 'SerialNumber')
    disk_serial = get_powershell_value('diskdrive', 'SerialNumber')
    failActivation() if not all([bios_serial, baseboard_serial, disk_serial]) else None
    raw = f'{bios_serial}-{baseboard_serial}-{disk_serial}'
    hwid = hashlib.sha256(raw.encode()).hexdigest()
    return hwid.strip()

def getLicense():
    key = input(Fore.BLUE + Style.BRIGHT + '[ACTIVATION]' + Style.RESET_ALL + ' Please enter your Product Key: ')
    key = key.strip()
    hwid = get_machine_hwid()
    with open(os.path.join(application_path, 'LICENSE.key'), 'w+') as f:
        f.write(key + '\n')
        f.write(hwid)
    f.close()
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.BLUE + Style.BRIGHT + '[ACTIVATION]' + Style.RESET_ALL + ' Validating. This may take a moment...')
    firebase_url = f'https://cyclonesstuff-default-rtdb.firebaseio.com/license_keys/{key}'
    try:
        res = r.get(firebase_url + '/validity.json')
    if res.status_code!= 200:
        failActivation()
    data = res.json()
    checkSuspension(data)
    if data!= 'unactivated':
        failActivation()
    try:
        r.patch(firebase_url + '.json', json={'hwid': hwid, 'validity': 'valid'})
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.YELLOW + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + f' Your Hardware ID {hwid} has been assigned to your Product Key {key}')
    checkForLicense()
    except Exception:
        failActivation()
    except Exception:
        failActivation()

def failActivation():
    global error  # inserted
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + ' Failed to authenticate/validate your Product ID/Hardware ID')
    error = True
    autoClose()

def checkSuspension(response):
    if response == 'suspended':
        import winsound
    pass
    winsound.Beep(500, 250)
    print(Style.RESET_ALL + Back.RED + Style.BRIGHT + '[ERROR] This license is suspended! Remove this program from your system IMMEDIATELY to prevent damage to your computer!')
    t.sleep(0.25)
    print(Style.RESET_ALL + Fore.RED + Style.BRIGHT + '[ERROR] This license is suspended! Remove this program from your system IMMEDIATELY to prevent damage to your computer!')
    continue

def checkForLicense():
    license_path = os.path.join(application_path, 'LICENSE.key')
    if not os.path.exists(license_path):
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.BLUE + Style.BRIGHT + '[ACTIVATION]' + Style.RESET_ALL + ' License not found. Starting activation setup...')
        t.sleep(3)
        getLicense()
    return None

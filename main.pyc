def setupApp():
    global waitTime  # inserted
    global waitType  # inserted
    global memoryThreshold  # inserted
    global useLander  # inserted
    global listenPort  # inserted
    global serverPort  # inserted
    serverPortInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Enter the desired account launching server port (blank to leave as-is): ' + Style.RESET_ALL)
    serverPort = serverPortInput if serverPortInput else serverPort
    useLanderInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Open the web interface landing page when deploying bots normally? (normal means not listening mode, y/n): ' + Style.RESET_ALL)
    if useLanderInput.lower() in ['yes', 'y', 'true', '1']:
        useLander = True
    listenPortInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Enter the desired interface web server port (blank to leave as-is): ' + Style.RESET_ALL)
    listenPort = listenPortInput if listenPortInput else listenPort
    waitTypeInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Enter the desired account launch wait type (0 for time, 1 for memory, 2 for both, blank to leave as-is): ' + Style.RESET_ALL)
    waitType = waitTypeInput if waitTypeInput else waitType
    waitTimeInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Enter the desired account launch cooldown time in seconds (blank to leave as-is): ' + Style.RESET_ALL)
    waitTime = waitTimeInput if waitTimeInput else waitTime
    memoryThresholdInput = input(Fore.LIGHTMAGENTA_EX + Style.NORMAL + 'Enter the desired memory percentage threshold to continue launching accounts (number only, blank to leave as-is): ' + Style.RESET_ALL)
    memoryThreshold = memoryThresholdInput if memoryThresholdInput else memoryThreshold
    save_config('serverPort', serverPort)
    save_config('listenPort', listenPort)
    save_config('waitType', waitType)
    save_config('waitTime', waitTime)
    save_config('memoryThreshold', memoryThreshold)
    save_config('useLander', useLander)
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.GREEN + Style.BRIGHT + '[SUCCESS]' + Style.RESET_ALL + ' Configuration updated.')
    print('')
    listAppConfiguration()

def config_line(label, value, box_width):
    label_plain = label
    value_plain = str(value)
    label_str = f'{Style.BRIGHT + Fore.YELLOW}{label}{Style.RESET_ALL}: '
    value_str = f'{Style.BRIGHT + Fore.WHITE}{value}{Style.RESET_ALL}'
    visible_len = len(label_plain) + 2 + len(value_plain)
    pad = box_width - 4 - visible_len
    pad = 0 if pad < 0 else pad
    return '│ ' + label_str + value_str + ' ' * pad + ' │'


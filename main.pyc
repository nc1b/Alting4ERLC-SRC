    confirm = input(Fore.MAGENTA + '[CONFIRM]' + Style.RESET_ALL + ' ' + Fore.LIGHTWHITE_EX + str(playersNum) + Style.RESET_ALL + ' bots to the server ' + Fore.LIGHTWHITE_EX + '\"' + serverCode + '\"' + Style.RESET_ALL + '.' + Fore.GREEN + ' Y/n: ' + Style.RESET_ALL)
    if confirm == 'Y' or confirm == 'y':
        print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.LIGHTYELLOW_EX + Style.BRIGHT + '[INFO]' + Style.RESET_ALL + ' Initializing...')
        overwriteFFlags()
        deployBots(serverCode, playersNum)
    print(Fore.WHITE + Style.BRIGHT + t.strftime('%H:%M:%S ') + Fore.RED + Style.BRIGHT + '[ERROR]' + Style.RESET_ALL + ' Bad input or no, cancelled.' + Style.RESET_ALL)

